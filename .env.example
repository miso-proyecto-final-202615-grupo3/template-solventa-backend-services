# Shared application settings
# Display name used by the greeting service. The math service sets its own name in Compose.
PROJECT_NAME=Template Project Backend Service

# Application release version.
VERSION=0.1.0

# Runtime environment label, such as local, dev, qa, or prod.
ENVIRONMENT=dev

# Greeting service database connection. The host "db" is the PostgreSQL Compose service;
# update the host to localhost when connecting from the host machine.
DATABASE_URL=postgresql+asyncpg://postgres:postgres:5432/appdb

# OpenTelemetry Collector OTLP gRPC endpoint (the local LGTM Compose service).
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317

# Optional API route prefix. Leave unset to use each service's own default prefix.
# API_PREFIX=/api/v1/greeting-service

# Local PostgreSQL database name, user, and dummy password.
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Dummy credentials for the local Grafana instance in the LGTM container.
GRAFANA_ADMIN_USER=grafana
GRAFANA_ADMIN_PASSWORD=grafana
